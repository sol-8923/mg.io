rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /notices/{who} {
      allow read: if who in ['dad', 'mom'];
      allow write: if who in ['dad', 'mom']
        && request.resource.data.keys().hasOnly(['text', 'updatedAt'])
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 300
        && request.resource.data.updatedAt is string;
    }
    match /plan/{doc} {
      allow get: if doc in ['routine', 'events', 'todos'];
      allow create, update: if doc in ['routine', 'events', 'todos']
        && request.resource.data.keys().hasOnly(['data', 'updatedAt'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 100000
        && request.resource.data.updatedAt is string;
      allow delete: if false;
    }
    match /chat/{msg} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['who', 'text', 'img', 'at'])
        && request.resource.data.who in ['dad', 'mom', 'min']
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 500
        && request.resource.data.at is number
        && (!('img' in request.resource.data)
            || (request.resource.data.img is string
                && request.resource.data.img.size() <= 700000
                && request.resource.data.img.matches('^data:image/jpeg;base64,.*')))
        && (request.resource.data.text.size() > 0 || 'img' in request.resource.data);
      allow update: if false;
      allow delete: if true;
    }
    match /chatwho/{who} {
      allow read: if who in ['dad', 'mom', 'min'];
      allow create, update: if who in ['dad', 'mom', 'min']
        && request.resource.data.keys().hasOnly(['device', 'at'])
        && request.resource.data.device is string
        && request.resource.data.device.size() <= 40
        && request.resource.data.at is number;
      allow delete: if who in ['dad', 'mom', 'min'];
    }
    match /chatread/{who} {
      allow read: if who in ['dad', 'mom', 'min'];
      allow create, update: if who in ['dad', 'mom', 'min']
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is number;
      allow delete: if false;
    }
    match /chattokens/{dev} {
      allow read: if false;
      allow create, update: if dev.size() <= 40
        && request.resource.data.keys().hasOnly(['who', 'token', 'at'])
        && request.resource.data.who in ['dad', 'mom', 'min']
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 500
        && request.resource.data.at is number;
      allow delete: if dev.size() <= 40;
    }
    match /secrets/{who} {
      allow get: if who in ['dad', 'mom'];
      allow create: if false;   // 기본 비밀번호 문서는 이미 만들어 두었다
      allow update: if who in ['dad', 'mom']
        && request.resource.data.keys().hasOnly(['pw', 'prev'])
        && request.resource.data.pw is string
        && request.resource.data.prev is string
        && request.resource.data.pw.size() >= 4 && request.resource.data.pw.size() <= 12
        && request.resource.data.prev == resource.data.pw;
      allow delete: if false;
    }
    // 공부 기록·필기 백업: 문서 이름이 "백업 코드(20자 무작위)-번호"라서 코드를 아는 기기만 읽는다(목록 조회 금지, 삭제 금지).
    match /backups/{id} {
      allow get: if id.size() >= 22 && id.size() <= 26;
      allow create, update: if id.size() >= 22 && id.size() <= 26
        && request.resource.data.keys().hasOnly(['d', 'at'])
        && request.resource.data.d is string
        && request.resource.data.d.size() <= 250000
        && request.resource.data.at is string;
      allow list, delete: if false;
    }
    // 문제 오류 신고(2026-11-17): 누구나 새 신고를 올릴 수 있고(수정·삭제 금지), 내려받기는 engine/reports_pull.py가 목록 조회로 한다.
    // 문제 본문 스냅샷과 신고 사유만 담기며 이름 등 개인정보는 없다.
    match /reports/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(['qid', 'book', 'unit', 'slot', 'cat', 'reason', 'snap', 'ver', 'at'])
        && request.resource.data.qid is string && request.resource.data.qid.size() >= 1 && request.resource.data.qid.size() <= 40
        && request.resource.data.book is string && request.resource.data.book.size() <= 40
        && request.resource.data.unit is string && request.resource.data.unit.size() <= 12
        && request.resource.data.slot is string && request.resource.data.slot.size() <= 12
        && request.resource.data.cat in ['answer', 'unclear', 'explain', 'typo', 'other']
        && request.resource.data.reason is string && request.resource.data.reason.size() >= 2 && request.resource.data.reason.size() <= 500
        && request.resource.data.snap is string && request.resource.data.snap.size() <= 8000
        && request.resource.data.ver is string && request.resource.data.ver.size() <= 20
        && request.resource.data.at is number;
      allow update, delete: if false;
    }
    match /{document=**} { allow read, write: if false; }
  }
}
